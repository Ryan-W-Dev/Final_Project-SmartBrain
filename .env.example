# Create a local .env file and paste a newly generated Hugging Face access token here.
HF_TOKEN=hf_your_new_token

# PostgreSQL. The value below matches the local Docker database in compose.yaml.
DATABASE_URL=postgresql://smartbrain:smartbrain@localhost:5432/smartbrain
# Hosted providers such as Neon expose a direct URL for migrations and exports.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
# Set to true when your hosted PostgreSQL provider requires TLS.
DATABASE_SSL=false

# Password reset links. APP_URL must be the public HTTPS URL in production.
APP_URL=http://localhost:5173
# Add a Resend API key and a sender from your verified domain for production email delivery.
# RESEND_API_KEY=re_your_resend_api_key
# Vercel's Resend integration provides this automatically.
# RESEND_EMAIL_DOMAIN=mail.your-domain.example
# RESET_EMAIL_FROM=Smart Brain <passwords@your-verified-domain.example>

# Optional server settings
PORT=3001
# HF_MODEL_URL=https://router.huggingface.co/hf-inference/models/facebook/detr-resnet-50
