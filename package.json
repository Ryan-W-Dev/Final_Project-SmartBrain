{
  "name": "smart-brain-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names client,api \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server.js",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:migrate": "node scripts/migrate-database.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "npm run build && tsx server.js",
    "start": "tsx server.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "particles-bg": "^2.5.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-parallax-tilt": "^1.7.337",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
